# AdeImmo frontend, variables d'environnement.
# Copier ce fichier en frontend/.env.local et renseigner les valeurs reelles.
# Seules les cles publiques doivent apparaitre ici : tout ce qui est prefixe
# NEXT_PUBLIC_ est envoye au navigateur.

# Supabase, Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
