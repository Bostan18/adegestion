# AdeImmo backend, variables d'environnement.
# Copier ce fichier en backend/.env et renseigner les valeurs reelles.
# Aucun secret ne doit etre commite dans le depot.

# --- Application ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Origines autorisees pour le frontend, separees par des virgules.
CORS_ORIGINS=http://localhost:3000

# --- Base de donnees ---
# Developpement local (docker compose) :
DATABASE_URL=postgresql+psycopg://adeimmo:adeimmo@localhost:5432/adeimmo
# Supabase (Project Settings > Database > Connection string > URI) :
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# --- Supabase ---
# Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Cle publique, utilisee uniquement par le frontend, presente ici pour reference.
SUPABASE_ANON_KEY=
# Cle privee, ne jamais l'exposer au navigateur. Sert au Storage cote serveur.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > API > JWT Settings > JWT Secret (algorithme HS256).
SUPABASE_JWT_SECRET=
# Audience attendue dans les jetons Supabase.
SUPABASE_JWT_AUDIENCE=authenticated

# --- Storage ---
SUPABASE_STORAGE_BUCKET=property-photos
SUPABASE_MAINTENANCE_BUCKET=maintenance-photos
# Duree de validite des URLs signees, en secondes.
SIGNED_URL_EXPIRES_IN=3600
